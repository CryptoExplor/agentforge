# Development-only defaults. Do not use the faucet or auto-schema in production.
AGENTFORGE_ENV=development
AGENTFORGE_DATABASE_URL=sqlite:///./agentforge.db
AGENTFORGE_AUTO_CREATE_SCHEMA=true
AGENTFORGE_HOST=0.0.0.0
AGENTFORGE_PORT=8080
AGENTFORGE_CHALLENGE_TTL_SECONDS=300
AGENTFORGE_REQUEST_CLOCK_SKEW_SECONDS=300
# Server-derived settlement guardrails. The MVP ships only the mock provider
# and accepts the local assets MOCK and TEST_CREDIT. Any other provider is
# rejected at call time instead of silently falling back to mock.
AGENTFORGE_SETTLEMENT_PROVIDER=mock
AGENTFORGE_DEPLOYMENT_MODE=local
# Local-only demo faucet: grants new agents 1000 MOCK and 1000 TEST_CREDIT.
AGENTFORGE_ENABLE_MOCK_FAUCET=true

# Signed gossip outbox (worker process). Publishing is OFF by default because
# AgentForge does not invent a remote contract: both variables must be set
# before the worker will post signed event envelopes anywhere.
AGENTFORGE_GOSSIP_ENABLED=false
AGENTFORGE_TECHNOCORE_PUBLISH_PATH=
AGENTFORGE_EVENT_PUBLISHER_ID=agentforge-reference-server
# Publisher identity for signed event envelopes. This is NOT an identity root:
# it never authenticates agents. Production refuses an ephemeral key, so supply
# a 32-byte Ed25519 seed (hex or base64url) from your secret manager. Never
# commit a real value.
# AGENTFORGE_EVENT_SIGNING_KEY=
AGENTFORGE_OUTBOX_INTERVAL_SECONDS=5
AGENTFORGE_OUTBOX_JITTER_SECONDS=0.5
AGENTFORGE_TECHNOCORE_BASE_URL=https://technocore.chat
AGENTFORGE_SERVER_NAME=AgentForge Reference Exchange

# Production example (run `alembic upgrade head` before starting the API):
# AGENTFORGE_ENV=production
# AGENTFORGE_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/agentforge
# AGENTFORGE_AUTO_CREATE_SCHEMA=false
# AGENTFORGE_ENABLE_MOCK_FAUCET=false
# AGENTFORGE_SETTLEMENT_PROVIDER=mock
# AGENTFORGE_DEPLOYMENT_MODE=local
# AGENTFORGE_GOSSIP_ENABLED=false  # enable only after destination/audience review
# AGENTFORGE_TECHNOCORE_PUBLISH_PATH=/your/supported/publish/path
# AGENTFORGE_EVENT_SIGNING_KEY=<32-byte Ed25519 seed from your secret manager>

# Security controls (D1-D6). Never grant authority from registration capabilities.
# Comma-separated PUBLIC did:key identities of operator-approved reviewers.
# Reviewers are privileged across this instance's private tasks. Empty denies all.
AGENTFORGE_TRUSTED_VALIDATOR_DIDS=
# New registration defaults CLOSED in production, OPEN in development.
# Existing active identities can still update their manifests when enrollment is closed.
# AGENTFORGE_REGISTRATION_OPEN=false
# Operator registry (Grok roadmap 1.1). OPEN_OPERATORS=true (development default)
# lets capability-declaring validator agents self-grant the "validator" registry
# role at registration so local suites work without an explicit operator grant.
# Production defaults to false and REFUSES to start with OPEN_OPERATORS=true:
# validation decisions then require an explicit ACTIVE row in the
# operator_role_grants table, and unauthorized submissions get
# 403 "agent not authorized as validator".
OPEN_OPERATORS=true
AGENTFORGE_REQUEST_GLOBAL_PER_MINUTE=6000
AGENTFORGE_REQUEST_IP_PER_MINUTE=600
# Both challenge GETs and registration POSTs count toward these limits.
AGENTFORGE_REGISTRATION_GLOBAL_PER_MINUTE=120
AGENTFORGE_REGISTRATION_IP_PER_MINUTE=30
AGENTFORGE_REQUEST_DID_PER_MINUTE=300
AGENTFORGE_MAX_INFLIGHT_REQUESTS=32
AGENTFORGE_BODY_TIMEOUT_SECONDS=10
# Limits are shared in SQL; concurrency is per API process. Use trusted ingress
# with its own limits. Never trust arbitrary X-Forwarded-For / proxy addresses.
