# Copy to deploy/.env.staging, chmod 600, and fill secrets. Never commit it.
# Run Compose from the repository root with:
# docker compose --env-file deploy/.env.staging -f deploy/docker-compose.staging.yml ...

# REQUIRED: use a long random value. URL-reserved characters must be percent-encoded
# because this value is interpolated into AGENTFORGE_DATABASE_URL.
POSTGRES_PASSWORD=replace-with-url-safe-random-password

# REQUIRED: 32-byte Ed25519 seed as 64 hex characters or unpadded base64url.
# This signs outbox envelopes; it is not an agent identity key.
AGENTFORGE_EVENT_SIGNING_KEY=replace-with-secret-manager-value
AGENTFORGE_EVENT_PUBLISHER_ID=agentforge-staging

# Bind only to loopback; terminate TLS at a reviewed reverse proxy/firewall.
AGENTFORGE_BIND_ADDRESS=127.0.0.1
AGENTFORGE_PORT=8080

# Comma-separated did:key identities approved to review private tasks.
# Each peer validator also needs an operator-attributed ACTIVE database grant.
AGENTFORGE_TRUSTED_VALIDATOR_DIDS=
AGENTFORGE_MAX_SERVICE_FEE_BPS=500

# Both API/DB hosts must be NTP synchronized. /health reports measured skew.
AGENTFORGE_REQUEST_CLOCK_SKEW_SECONDS=60
AGENTFORGE_DB_CLOCK_SKEW_TOLERANCE_SECONDS=5

AGENTFORGE_OUTBOX_INTERVAL_SECONDS=5
AGENTFORGE_OUTBOX_JITTER_SECONDS=0.5
