    "/api/v1/tasks/{task_id}/validations": {
      "post": {
        "summary": "Create Task Validation",
        "description": "Submit a signed peer-validation decision for a task's pending proof.\n\nTask-scoped peer validation: the server resolves the task's submission\nthat is awaiting validation (``SUBMITTED``, or ``DISPUTED`` so a\nvalidation also closes the dispute). The operator authorization gate is\nidentical to the submission-scoped endpoint: operator allowlist entry,\ndeclared validation capability, and an effective ``validator`` registry\nrole (explicit grant, or development ``OPEN_OPERATORS``\nself-registration). Everything else — signature verification,\nindependence checks, deterministic cross-check, atomic settlement — is\nthe shared ``apply_validation`` path.",
        "operationId": "create_task_validation_api_v1_tasks__task_id__validations_post",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Task Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
